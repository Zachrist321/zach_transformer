   "outputs": [],
   "source": [
    "arr = [8, 7, 3, 9]\n",
    "\n",
    "for i in range(1,len(arr)):\n",
    "    key = arr[i]\n",
    "    j = i - 1\n",
    "    while j >= 0:\n",
    "        if arr[j] > key:\n",
    "            arr[j + 1] = arr[j]\n",
    "            j -= 1\n",
    "    arr[j + 1] = key"
   ]
