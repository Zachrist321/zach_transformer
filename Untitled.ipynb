   "outputs": [],
   "source": [
    "A = [13, 2, 8, 1]\n",
    "for i in range(1, len(A)):\n",
    "    key = A[i]\n",
    "    j = i - 1\n",
    "    while j >= 0 and A[j] > key:\n",
    "        A[j + 1] = A[j]\n",
    "        j -= 1\n",
    "    A[j + 1] = key"
   ]
  },
