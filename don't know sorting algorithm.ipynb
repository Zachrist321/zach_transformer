   "id": "07c717da-052f-41d8-b1f3-34ffa5c9c9d8",
   "metadata": {},
   "outputs": [],
   "source": [
    "arr = np.random.randint(1, 100, (30))\n",
    "n = len(arr) - 1\n",
    "while n >= 0:\n",
    "    for i in range(n):\n",
    "        if arr[i] > arr[i + 1]:\n",
    "            arr[i], arr[i + 1] = arr[i + 1], arr[i]\n",
    "    n -= 1"
   ]
