   "source": [
    "arr = [10, 8, 3, 2]\n",
    "pivot = arr[len(arr) - 1]\n",
    "i = -1\n",
    "for j in range(0, len(arr) - 1):\n",
    "    if arr[j] <= pivot:\n",
    "        i += 1\n",
    "        arr[i], arr[j] = arr[j], arr[i]\n",
    "arr[i + 1], arr[len(arr) - 1] = arr[len(arr) - 1], arr[i + 1]"
   ]
