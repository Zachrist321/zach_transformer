   "metadata": {},
   "outputs": [],
   "source": [
    "x = np.arange(-1000, 1000)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "f92c8e0f-d670-4eb2-8e67-44d145e1a1e1",
   "metadata": {},
   "outputs": [],
   "source": [
